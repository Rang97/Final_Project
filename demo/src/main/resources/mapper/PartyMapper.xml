<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.domain.party.repository.PartyMapper">

    <!--  파티 조회  -->
    <select id="findById" resultType="Party">
        SELECT * from party
        WHERE party_id = #{partyId}
    </select>

    <!--  파티 목록 조회 (정렬 포함)  -->
    <select id="findPartyList" resultType="PartyListResponse">
        SELECT p.*, g.name_ko AS gameName, g.genre AS genre
        FROM party p
        JOIN game g ON p.game_id = g.game_id
        <choose>
            <when test="sortBy != null and sortBy.name() == 'TITLE'">
                ORDER BY g.name_ko <if test="ascending">ASC</if><if test="!ascending">DESC</if>
            </when>
            <when test="sortBy != null and sortBy.name() == 'GENRE'">
                ORDER BY g.genre <if test="ascending">ASC</if><if test="!ascending">DESC</if>
            </when>
            <when test="sortBy != null and sortBy.name() == 'MEMBER_COUNT'">
                ORDER BY p.now_member_count <if test="ascending">ASC</if><if test="!ascending">DESC</if>
            </when>
            <otherwise>ORDER BY p.created_at DESC</otherwise>
        </choose>
    </select>

        <!--  파티 생성  -->
<insert id="insertParty" parameterType="Party" useGeneratedKeys="true" keyProperty="partyId">
INSERT INTO party (host_id, game_id, title, max_member_count, chemistry_type, status)
VALUES (#{hostId}, #{gameId}, #{title}, #{maxMemberCount}, #{chemistryType}, #{status})
</insert>

        <!--  파티 삭제  -->
<delete id="deleteParty">
DELETE from party
WHERE party_id = #{partyId}
</delete>

        <!--  파티 인원 갱신  -->
<update id="updateMemberCount">
UPDATE party SET now_member_count = #{memberCount}
WHERE party_id = #{partyId}
</update>

        <!--  파티 상태 변경  -->
<update id="updateStatus">
UPDATE party SET status = #{status}
WHERE party_id = #{partyId}
</update>

        </mapper>