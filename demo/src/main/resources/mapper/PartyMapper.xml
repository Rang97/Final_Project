<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.domain.party.repository.PartyMapper">

    <!--  파티 조회  -->
    <select id="findById" resultType="Party">
        SELECT * from party
        WHERE party_id = #{partyId}
    </select>

    <!--  파티 전체 조회  -->
    <select id="findAllParty" resultType="Party">
        SELECT * from party
    </select>

    <!--  파티 생성  -->
    <insert id="insertParty" parameterType="Party" useGeneratedKeys="true" keyProperty="partyId">
        INSERT INTO party (host_id, game_id, title, max_member_count, chemistry_type, status)
        VALUES (#{hostId}, #{gameId}, #{title}, #{maxMemberCount}, #{chemistryType}, #{status})
    </insert>

    <!--  파티 삭제  -->
    <delete id="deleteParty">
        DELETE from party
        WHERE party_id = #{partyId}
    </delete>

    <!--  파티 인원 갱신  -->
    <update id="updateMemberCount">
        UPDATE party SET now_member_count = #{memberCount}
        WHERE party_id = #{partyId}
    </update>

</mapper>