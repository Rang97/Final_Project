<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.domain.saju.repository.SajuInputMapper">

    <insert id="insert"
            parameterType="com.example.demo.domain.saju.entity.SajuInput"
            useGeneratedKeys="true"
            keyProperty="sajuInputId">
        INSERT INTO saju_input (
            user_id,
            birth_date,
            gender,
            calendar_type,
            birth_time_type,
            birth_time_branch
        )
        VALUES (
            #{userId},
            #{birthDate},
            #{gender},
            #{calendarType},
            #{birthTimeType},
            #{birthTimeBranch}
        )
    </insert>

</mapper>
